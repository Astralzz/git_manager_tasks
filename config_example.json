{
  "repo_roots": {
    "front": "Gatherleads/frontend",
    "backend": "Gatherleads/backend",
    "mobile": "Projects/mobile"
  },
  "branch_types": {
    "hotfix": {
      "prefix": "hotfix/",
      "environment": "QA QUITO"
    },
    "release": {
      "prefix": "release/",
      "environment": "QA ARG"
    },
    "feature": {
      "prefix": "feature/",
      "environment": "DEV"
    }
  },
  "areas": [
    {
      "id": "front",
      "name": "Front",
      "root": "front",
      "groups": [
        {
          "id": "web",
          "name": "Aplicación web",
          "projects": [
            {
              "id": "main-web-page",
              "name": "Main Web Page",
              "folder": "main_web_page",
              "branch_base_defaults": {
                "hotfix": "main",
                "release": "main",
                "feature": "main"
              },
              "branches": [
                {
                  "id": "GL-1234",
                  "name": "GL-1234 - Flujo de ejemplo",
                  "slug": "ejemplo-de-tarea",
                  "types": {
                    "hotfix": {
                      "base": "main"
                    },
                    "release": {
                      "base": "main"
                    },
                    "feature": {
                      "base": "release",
                      "suffix": "-units"
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "mobile",
          "name": "Aplicación móvil",
          "root": "mobile",
          "projects": [
            {
              "id": "mobile-app",
              "name": "Aplicación móvil",
              "folder": "gl-app",
              "branch_base_defaults": {
                "hotfix": "main",
                "release": "main",
                "feature": "main"
              },
              "branches": []
            }
          ]
        },
        {
          "id": "libraries",
          "name": "Librerías",
          "projects": [
            {
              "id": "ui-library",
              "name": "GatherLeads UI Lib",
              "folder": "libraries/carconnect-gatherleads-ui-lib",
              "branch_base_defaults": {
                "hotfix": "main",
                "release": "main",
                "feature": "main"
              },
              "branches": []
            }
          ]
        }
      ]
    },
    {
      "id": "back",
      "name": "Back",
      "root": "backend",
      "groups": [
        {
          "id": "principal",
          "name": "Proyectos principales",
          "projects": [
            {
              "id": "backoffice",
              "name": "Backoffice",
              "folder": "backoffice",
              "branch_base_defaults": {
                "hotfix": "main",
                "release": "main",
                "feature": "main"
              },
              "branches": []
            }
          ]
        }
      ]
    }
  ]
